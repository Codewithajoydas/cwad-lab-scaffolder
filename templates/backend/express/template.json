{
  "id": "express-javascript",
  "name": "Express API",
  "description": "Professional Express API template",
  "category": "backend",
  "language": "javascript",
  "framework": "express",
  "runtime": "node",
  "packageManager": "pnpm",
  "supports": {
    "typescript": false,
    "testing": true,
    "docker": true
  },
  "shared": [
    "git",
    "common",
    "prettier",
    "documentation"
  ],
  "variables": [
    "PROJECT_NAME",
    "PROJECT_SLUG",
    "PACKAGE_NAME",
    "DESCRIPTION",
    "AUTHOR_NAME",
    "AUTHOR_EMAIL",
    "LICENSE",
    "YEAR",
    "PORT"
  ],
  "version": "1.0.0"
}
